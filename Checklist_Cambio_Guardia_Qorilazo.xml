          <doc_certificado_gps>OK</doc_certificado_gps>
          <doc_certificado_operatividad>OK</doc_certificado_operatividad>
          <doc_inspeccion_semestral>OK</doc_inspeccion_semestral>
          <doc_checklist_mantenimiento>OK</doc_checklist_mantenimiento>

          <!-- 3. Cabina de Operación -->
          <cabina_asiento>BUENO</cabina_asiento>
          <cabina_correa>BUENO</cabina_correa>
