          <herr_manguera_aire>BUENO</herr_manguera_aire>
          <herr_medidor_aire>BUENO</herr_medidor_aire>
          <herr_pala_pico>BUENO</herr_pala_pico>
          <herr_medidor_cocadas>BUENO</herr_medidor_cocadas>
          <herr_llaves_mixtas>BUENO</herr_llaves_mixtas>
          <herr_alicate>BUENO</herr_alicate>
          <herr_destornillador>BUENO</herr_destornillador>
          <herr_linterna>BUENO</herr_linterna>
          <herr_martillo_goma>BUENO</herr_martillo_goma>

          <!-- 7. Neumáticos (1 a 10 + Repuesto) -->
          <pos_1_mm/><pos_1_est>BUENO</pos_1_est>
          <pos_2_mm/><pos_2_est>BUENO</pos_2_est>
          <pos_3_mm/><pos_3_est>BUENO</pos_3_est>
          <pos_4_mm/><pos_4_est>BUENO</pos_4_est>
          <pos_5_mm/><pos_5_est>BUENO</pos_5_est>
          <pos_6_mm/><pos_6_est>BUENO</pos_6_est>
          <pos_7_mm/><pos_7_est>BUENO</pos_7_est>
          <pos_8_mm/><pos_8_est>BUENO</pos_8_est>
          <pos_9_mm/><pos_9_est>BUENO</pos_9_est>
          <pos_10_mm/><pos_10_est>BUENO</pos_10_est>
          <pos_repuesto_mm/><pos_repuesto_est>BUENO</pos_repuesto_est>

          <!-- 8. Evidencias y Observaciones -->
          <foto_combustible/>
          <foto_cabina/>
          <foto_hallazgo_1/>
          <foto_hallazgo_2/>
          <observaciones_estado_equipo/>
          <observaciones_adicionales/>

          <!-- 9. Firmas -->
          <firma_operador/>
          <firma_supervisor/>
        </data>
      </instance>

      <!-- Bindings y Validaciones -->
      <bind nodeset="/data/fecha_inspeccion" type="date" jr:preload="date" jr:preloadParams="today"/>
      <bind nodeset="/data/guardia" type="string" required="true()"/>
      <bind nodeset="/data/nombre_operador" type="string" required="true()"/>
      <bind nodeset="/data/dni_operador" type="string"/>
      <bind nodeset="/data/codigo_placa" type="string" required="true()"/>
      <bind nodeset="/data/km_hr" type="decimal" required="true()"/>

      <!-- Fotos y Firmas -->
      <bind nodeset="/data/foto_combustible" type="binary"/>
      <bind nodeset="/data/foto_cabina" type="binary"/>
      <bind nodeset="/data/foto_hallazgo_1" type="binary"/>
      <bind nodeset="/data/foto_hallazgo_2" type="binary"/>
      <bind nodeset="/data/firma_operador" type="binary" required="true()"/>
      <bind nodeset="/data/firma_supervisor" type="binary"/>
    </model>
  </h:head>

